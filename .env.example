# Copy this file to .env after you receive the competition API information.
# Keep the real key only on the backend. Never put it in frontend JavaScript.

MODEL_API_KEY=
MODEL_BASE_URL=https://api.example.com/v1
MODEL_NAME=qwen-or-glm-model-name

# Set to 1 while learning. The backend will return a realistic fake answer.
MOCK_MODE=1

# Optional local checks after starting uvicorn:
# GET  /api/model/config  -> see whether backend config is complete
# POST /api/model/probe   -> send a short test request to the model provider
